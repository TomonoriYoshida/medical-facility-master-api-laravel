# Production settings for compose.production.yaml (see DEPLOY.md).
# Copy to .env on the server and fill in every <...> value.
# Keep values unquoted and free of ${...}: docker compose reads this file too.

# Lets plain `docker compose ...` use the production stack.
COMPOSE_FILE=compose.production.yaml

APP_NAME=medical-facility-master-api
APP_ENV=production
APP_KEY=<generated by key:generate --show>
APP_DEBUG=false
APP_URL=https://<SERVER_NAME>
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# The server's public IP with dots replaced by hyphens, e.g.
# 203-0-113-1.sslip.io, or your own domain once it points at the server.
SERVER_NAME=<203-0-113-1.sslip.io>

API_RATE_LIMIT_PER_MINUTE=60

# Limit what is crawled and stored (README "取り扱う範囲の設定"); empty means everything.
RHB_PREFECTURES=
RHB_CATEGORIES=

# Ping URLs of the two healthchecks.io checks (DEPLOY.md "監視"); empty disables pinging.
RHB_HEALTHCHECK_DOWNLOAD_URL=
RHB_HEALTHCHECK_STATUS_URL=

# Daily files in storage/logs (kept LOG_DAILY_DAYS days, survive deploys),
# plus stderr for `docker compose logs`, plus error notifications (DEPLOY.md "ログ").
LOG_CHANNEL=stack
LOG_STACK=daily,stderr,alert
LOG_DAILY_DAYS=14
LOG_LEVEL=info
# Slack or Discord webhook for errors (Discord: append /slack to the URL); empty disables.
LOG_ALERT_WEBHOOK_URL=

# access-log:check alerts when yesterday had at least this many 429s / 404s, or
# requests from one IP (DEPLOY.md "不審なアクセスの確認と遮断").
ACCESS_ALERT_RATE_LIMITED=50
ACCESS_ALERT_NOT_FOUND=200
ACCESS_ALERT_REQUESTS_PER_IP=3000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=medical_facility_master
DB_USERNAME=app
DB_PASSWORD=<random password>
DB_ROOT_PASSWORD=<another random password>
MYSQL_INNODB_BUFFER_POOL_SIZE=512M

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=650
FILESYSTEM_DISK=local

MAIL_MAILER=log
